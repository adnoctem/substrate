<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference
      Include="PowerShellStandard.Library"
      Version="5.1.1"
      PrivateAssets="all"
      ExcludeAssets="runtime"
    />
    <ProjectReference Include="../Core/Core.csproj" />
    <ProjectReference Include="../Office/Office.csproj" />
    <ProjectReference Include="../Security/Security.csproj" />
    <ProjectReference Include="../Packages/Packages.csproj" />
    <ProjectReference Include="../Windows/Windows.csproj" />
    <ProjectReference Include="../Interop/Interop.csproj" />
    <ProjectReference Include="../Diagnostics/Diagnostics.csproj" />
    <ProjectReference Include="../IO/IO.csproj" />
    <ProjectReference Include="../Policies/Policies.csproj" />
    <ProjectReference Include="../Networking/Networking.csproj" />
    <ProjectReference Include="../Registry/Registry.csproj" />
  </ItemGroup>
  <!-- Document generation requires PowerShell 7; Windows PowerShell 5.1 does not carry the Open XML dependency. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <ProjectReference Include="../Documents/Documents.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <PackageReference
      Include="Microsoft.NETFramework.ReferenceAssemblies"
      Version="1.0.3"
      PrivateAssets="all"
    />
  </ItemGroup>
</Project>
