{
  "metadata": [{
    "src": [{ "src": "../build/module/AdNoctem.Substrate.PowerShell/lib/Core", "files": ["AdNoctem.Substrate.*.dll"], "exclude": ["AdNoctem.Substrate.PowerShell.dll"] }],
    "dest": "../build/docs/api",
    "disableGitFeatures": true,
    "memberLayout": "samePage"
  }],
  "build": {
    "content": [
      { "src": "../docs/www", "files": ["**/*.md", "toc.yml"], "dest": "." },
      { "src": "../build/docs/commands", "files": ["toc.yml"], "dest": "commands" },
      { "src": "../build/docs/api", "files": ["**/*.yml"], "dest": "api" }
    ],
    "output": "../build/docs/site",
    "template": ["default", "modern"],
    "globalMetadata": { "_appTitle": "substrate", "_enableSearch": true },
    "disableGitFeatures": true
  }
}
