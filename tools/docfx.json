{
  "metadata": [{
    "src": [{ "src": "../build/module/PSFoundation/lib/Core", "files": ["PSFoundation.*.dll"], "exclude": ["PSFoundation.PowerShell.dll"] }],
    "dest": "../build/docs/api",
    "disableGitFeatures": true,
    "memberLayout": "samePage"
  }],
  "build": {
    "content": [
      { "src": "../docs", "files": ["index.md", "API.md", "architecture.md", "documentation.md", "troubleshooting.md", "vendor-updates.md", "registry-api.md", "networking-api.md", "toc.yml", "commands/**/*.md"], "dest": "." },
      { "src": "../build/docs/api", "files": ["**/*.yml"], "dest": "api" }
    ],
    "output": "../build/docs/site",
    "template": ["default", "modern"],
    "globalMetadata": { "_appTitle": "PSFoundation", "_enableSearch": true },
    "disableGitFeatures": true
  }
}
