<Project>
  <PropertyGroup>
    <!-- File paths stay short; assembly and resource identities remain fully qualified. -->
    <RootNamespace>AdNoctem.Substrate.$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>$(RootNamespace)</AssemblyName>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <VersionPrefix>1.0.0</VersionPrefix>
    <IsPackable
      Condition="'$(MSBuildProjectName)' == 'PowerShell' or '$(MSBuildProjectName)' == 'WinRtHost'"
      >false</IsPackable>
    <Authors>Ad Noctem Collective</Authors>
    <Description>Reusable $(MSBuildProjectName) APIs for Windows administration and automation.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/adnoctem/substrate</PackageProjectUrl>
    <RepositoryUrl>https://github.com/adnoctem/substrate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile
      Condition="'$(MSBuildProjectName)' != 'WinRtHost' and !$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Tests'))"
      >true</GenerateDocumentationFile>
    <!-- Self-describing members remain visible in generated reference without filler prose. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)build/packages</RestorePackagesPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)build/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)build/bin/$(MSBuildProjectName)/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None
      Include="$(MSBuildThisFileDirectory)docs/www/guides/libraries.md"
      Pack="true"
      PackagePath="/README.md"
    />
  </ItemGroup>
</Project>
